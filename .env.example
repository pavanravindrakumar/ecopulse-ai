# EcoPulse AI Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# App identity
VITE_APP_NAME=EcoPulse AI
VITE_APP_VERSION=1.0.0

# Feature flags (set to "true" or "false")
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_NOTIFICATIONS=false

# Storage key prefix (change to invalidate all local storage)
VITE_STORAGE_VERSION=v1
